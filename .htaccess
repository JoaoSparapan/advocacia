RewriteEngine on

# bloqueia arquivos ocultos (.git, .DS_Store, .user.ini) e o que não deve ser acessado pela web
RewriteRule (^|/)\. - [F,L]
RewriteRule ^services/(composer\.(json|lock)|vendor/|Mailer/) - [F,L]
RewriteRule ^(files|modelos)/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php
# redireciona quando da erro 404
ErrorDocument 404 http://%{HTTP_HOST}/advocacia/pages/not-found.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
